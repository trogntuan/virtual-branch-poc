POSTGRES_DB=virtual_branch
POSTGRES_USER=virtual_branch
POSTGRES_PASSWORD=virtual_branch

# MinIO — only for self-hosted LiveKit + local egress mode
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=virtual-branch

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=virtual_branch_poc_dev_secret_2026

# LiveKit Cloud (optional)
# VB_LIVEKIT_API_URL=https://your-project.livekit.cloud
# VB_LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# --- PDF / documents: GCS (recommended with LiveKit Cloud) ---
# Run once: infra/gcp/setup-gcs-storage.sh
# Local dev: gcloud auth application-default login
# VB_STORAGE_PROVIDER=gcs
# VB_STORAGE_BUCKET=your-project-vb-poc
# VB_STORAGE_ENDPOINT=https://storage.googleapis.com
# VB_STORAGE_FORCE_PATH_STYLE=true

# --- Recording: Cloudflare R2 (LiveKit Cloud egress — separate from GCS PDF) ---
# Dashboard → R2 → Create bucket → Manage R2 API Tokens (Object Read & Write)
# Endpoint: https://<account_id>.r2.cloudflarestorage.com
# VB_EGRESS_BUCKET=virtual-branch-recordings
# VB_EGRESS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# VB_EGRESS_ACCESS_KEY=your_r2_access_key_id
# VB_EGRESS_SECRET_KEY=your_r2_secret_access_key
# VB_EGRESS_REGION=auto
# VB_EGRESS_FORCE_PATH_STYLE=true
# Verify: infra/r2/verify-r2.sh

# --- Local MinIO mode (self-hosted LiveKit only) ---
# VB_STORAGE_PROVIDER=s3
# VB_STORAGE_ENDPOINT=http://localhost:9000
# VB_STORAGE_BUCKET=virtual-branch
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin123
