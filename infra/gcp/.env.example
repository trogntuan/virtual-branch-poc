# GCP + LiveKit Cloud — copy values to Cloud Run / Secret Manager (do NOT commit secrets)

SPRING_PROFILES_ACTIVE=prod

# Cloud SQL (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql:///virtual_branch?cloudSqlInstance=PROJECT:asia-southeast1:vb-poc-db&socketFactory=com.google.cloud.sql.postgres.SocketFactory
SPRING_DATASOURCE_USERNAME=virtual_branch
# SPRING_DATASOURCE_PASSWORD -> Secret Manager: vb-db-password

# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_API_KEY=APIH2B7fs9yeH5v
# LIVEKIT_API_SECRET -> Secret Manager: vb-livekit-secret
VB_LIVEKIT_API_URL=https://virtual-branch-burlw8j5.livekit.cloud
VB_LIVEKIT_WS_URL=wss://virtual-branch-burlw8j5.livekit.cloud

# GCS via S3-compatible HMAC (Interoperability)
STORAGE_ACCESS_KEY=your_gcs_hmac_access_key
# STORAGE_SECRET_KEY -> Secret Manager: vb-storage-secret
VB_STORAGE_ENDPOINT=https://storage.googleapis.com
VB_STORAGE_BUCKET=your-project-vb-poc
VB_STORAGE_REGION=
VB_STORAGE_FORCE_PATH_STYLE=true

# Agent Web origin (comma-separated for multiple)
VB_CORS_ALLOWED_ORIGINS=https://agent.yourdomain.com
